---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import FeatureItem from '../../components/FeatureItem.astro';
import { Users, Lightbulb, Heart, Rocket } from 'lucide-react';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const values = [
  {
    title: 'Customer First',
    description: 'We prioritize our customers needs and strive for their satisfaction above all else.',
    icon: Heart,
    color: 'text-rose-600 bg-rose-50',
  },
  {
    title: 'Innovation',
    description: 'We embrace change and constantly push boundaries to find better ways to solve problems.',
    icon: Lightbulb,
    color: 'text-amber-600 bg-amber-50',
  },
  {
    title: 'Collaboration',
    description: 'Our success is built on teamwork and strong partnerships with our clients.',
    icon: Users,
    color: 'text-emerald-600 bg-emerald-50',
  },
  {
    title: 'Integrity',
    description: 'We maintain the highest standards of honesty and transparency in everything we do.',
    icon: Shield,
    color: 'text-blue-600 bg-blue-50',
  },
];
---

<BaseLayout title={`About Us | Company Name`}>
  <!-- Page Header -->
  <div class="bg-slate-900 py-24 md:py-32 relative overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src="https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&q=80&w=2069"
        alt="About Us Background"
        class="w-full h-full object-cover opacity-20"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-slate-900/50 to-slate-900"></div>
    </div>
    <div class="container-custom relative z-10 text-center text-white animate-in fade-in slide-in-from-bottom duration-700">
      <h1 class="text-4xl md:text-6xl font-extrabold mb-6">Building the Future Together</h1>
      <p class="text-xl text-slate-300 max-w-3xl mx-auto leading-relaxed">
        We are a team of dedicated professionals passionate about creating innovative technology solutions that empower businesses.
      </p>
    </div>
  </div>

  <!-- Mission & Vision -->
  <Section background="white">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
      <div class="space-y-6">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900">Our Mission</h2>
        <p class="text-lg text-slate-600 leading-relaxed">
          To provide cutting-edge digital solutions that help businesses of all sizes thrive in the modern economy. We believe in the power of technology to simplify complex problems and create new opportunities.
        </p>
        <p class="text-lg text-slate-600 leading-relaxed">
          Founded in 2015, we've grown from a small startup to a global provider of enterprise-grade software and services. Our commitment to innovation and customer success remains at the heart of everything we do.
        </p>
      </div>
      <div class="relative rounded-2xl overflow-hidden shadow-2xl group">
        <img
          src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&q=80&w=2070"
          alt="Team Collaboration"
          class="w-full h-auto transition-transform duration-700 group-hover:scale-105"
        />
        <div class="absolute inset-0 border-[12px] border-white/10 pointer-events-none rounded-2xl m-4"></div>
      </div>
    </div>
  </Section>

  <!-- Core Values -->
  <Section
    title="Our Core Values"
    subtitle="The principles that guide our work every single day."
    background="slate"
  >
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {values.map(value => (
        <FeatureItem {...value} />
      ))}
    </div>
  </Section>

  <!-- Timeline/History -->
  <Section title="Our Journey" background="white">
    <div class="max-w-4xl mx-auto space-y-12">
      <div class="flex flex-col md:flex-row gap-8 items-center md:items-start group">
        <div class="shrink-0 w-24 h-24 bg-brand-600 rounded-full flex items-center justify-center text-white text-xl font-bold shadow-lg shadow-brand-500/30 group-hover:scale-110 transition-transform">
          2015
        </div>
        <div class="bg-slate-50 p-8 rounded-2xl border border-slate-100 flex-grow shadow-sm group-hover:shadow-md transition-all">
          <h3 class="text-xl font-bold text-slate-900 mb-2">Company Founded</h3>
          <p class="text-slate-600 leading-relaxed">Started as a small team in a garage with a big vision for the future of cloud computing.</p>
        </div>
      </div>
      
      <div class="flex flex-col md:flex-row-reverse gap-8 items-center md:items-start group">
        <div class="shrink-0 w-24 h-24 bg-brand-600 rounded-full flex items-center justify-center text-white text-xl font-bold shadow-lg shadow-brand-500/30 group-hover:scale-110 transition-transform">
          2018
        </div>
        <div class="bg-slate-50 p-8 rounded-2xl border border-slate-100 flex-grow shadow-sm group-hover:shadow-md transition-all text-right md:text-left">
          <h3 class="text-xl font-bold text-slate-900 mb-2">Global Expansion</h3>
          <p class="text-slate-600 leading-relaxed">Opened our first international office in London and reached 100 enterprise customers.</p>
        </div>
      </div>

      <div class="flex flex-col md:flex-row gap-8 items-center md:items-start group">
        <div class="shrink-0 w-24 h-24 bg-brand-600 rounded-full flex items-center justify-center text-white text-xl font-bold shadow-lg shadow-brand-500/30 group-hover:scale-110 transition-transform">
          2022
        </div>
        <div class="bg-slate-50 p-8 rounded-2xl border border-slate-100 flex-grow shadow-sm group-hover:shadow-md transition-all">
          <h3 class="text-xl font-bold text-slate-900 mb-2">Innovation Award</h3>
          <p class="text-slate-600 leading-relaxed">Recognized as the "Most Innovative Tech Company" in the industry for our groundbreaking security solutions.</p>
        </div>
      </div>
    </div>
  </Section>

  <!-- CTA -->
  <Section background="brand" className="bg-brand-50">
    <div class="text-center max-w-3xl mx-auto py-10">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">Join Our Team</h2>
      <p class="text-lg text-slate-600 mb-10 leading-relaxed">
        We're always looking for talented individuals to join our mission. Explore our open positions and find your next challenge.
      </p>
      <a href={`/${lang}/contact`} class="btn btn-primary px-10 py-4 text-lg font-bold shadow-xl shadow-brand-500/20">
        Work with Us
      </a>
    </div>
  </Section>
</BaseLayout>
