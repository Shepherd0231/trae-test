---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Section from '../../../components/Section.astro';
import NewsCard from '../../../components/NewsCard.astro';
import { Search, Filter, Calendar, User, ChevronRight, LayoutGrid, List } from 'lucide-react';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const categories = ['All', 'Industry', 'Company', 'Product', 'Events'];

const newsItems = [
  {
    id: 'n1',
    title: 'The Future of Cloud Computing',
    excerpt: 'Exploring how AI and machine learning are revolutionizing cloud infrastructure and data processing for enterprises of all sizes.',
    date: 'March 15, 2026',
    author: 'Sarah Johnson',
    image: 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&q=80&w=2072',
    category: 'Industry',
  },
  {
    id: 'n2',
    title: 'Sustainable Tech Initiatives',
    excerpt: 'Our commitment to green energy and reducing the carbon footprint of digital operations through innovative data center cooling systems.',
    date: 'March 10, 2026',
    author: 'Michael Chen',
    image: 'https://images.unsplash.com/photo-1473341304170-971dccb5ac1e?auto=format&fit=crop&q=80&w=2070',
    category: 'Company',
  },
  {
    id: 'n3',
    title: 'Smart Analytics Pro 2.0 Released',
    excerpt: 'The latest version of our analytics tool features real-time predictive modeling and enhanced security for sensitive data sets.',
    date: 'March 5, 2026',
    author: 'Emily Davis',
    image: 'https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&q=80&w=2426',
    category: 'Product',
  },
  {
    id: 'n4',
    title: 'Global Tech Summit 2026',
    excerpt: 'Join us at the upcoming Global Tech Summit where we will showcase our latest advancements in AI and cybersecurity.',
    date: 'February 28, 2026',
    author: 'John Smith',
    image: 'https://images.unsplash.com/photo-1540575861501-7ad060e39fe1?auto=format&fit=crop&q=80&w=2070',
    category: 'Events',
  },
];
---

<BaseLayout title={`News | Company Name`}>
  <!-- Page Header -->
  <div class="bg-slate-900 py-20 relative overflow-hidden">
    <div class="container-custom relative z-10 text-center text-white">
      <h1 class="text-4xl md:text-5xl font-extrabold mb-6">Latest News & Insights</h1>
      <p class="text-xl text-slate-300 max-w-2xl mx-auto leading-relaxed">
        Stay updated with the latest industry trends, company news, and product announcements.
      </p>
    </div>
  </div>

  <!-- Filter & Search Bar -->
  <Section background="slate" className="py-8 border-b border-slate-200">
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-8">
      <div class="flex flex-wrap items-center gap-2">
        {categories.map(category => (
          <button
            class={`px-6 py-2.5 rounded-full text-sm font-semibold transition-all duration-300 ${
              category === 'All'
                ? 'bg-brand-600 text-white shadow-lg shadow-brand-500/20'
                : 'bg-white text-slate-600 border border-slate-200 hover:border-brand-300 hover:text-brand-600'
            }`}
          >
            {category}
          </button>
        ))}
      </div>

      <div class="relative flex-grow lg:max-w-md">
        <Search class="absolute left-4 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-400" />
        <input
          type="text"
          placeholder="Search news..."
          class="w-full bg-white border border-slate-200 rounded-full px-12 py-3 text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-all"
        />
      </div>
    </div>
  </Section>

  <!-- News Content -->
  <Section background="white">
    <!-- Featured News (Top Post) -->
    <div class="mb-20">
      <div class="group relative bg-white border rounded-3xl overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-500">
        <div class="grid grid-cols-1 lg:grid-cols-2">
          <div class="aspect-video lg:aspect-auto overflow-hidden">
            <img
              src={newsItems[0].image}
              alt={newsItems[0].title}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
          </div>
          <div class="p-8 md:p-12 lg:p-16 flex flex-col justify-center">
            <div class="flex items-center gap-4 text-xs text-brand-600 font-bold uppercase tracking-widest mb-6">
              <span class="bg-brand-50 px-3 py-1.5 rounded-full">{newsItems[0].category}</span>
              <span class="text-slate-400 font-normal">Featured</span>
            </div>
            <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-6 group-hover:text-brand-600 transition-colors">
              <a href={`/${lang}/news/${newsItems[0].id}`}>{newsItems[0].title}</a>
            </h2>
            <p class="text-lg text-slate-600 mb-10 leading-relaxed line-clamp-3">
              {newsItems[0].excerpt}
            </p>
            <div class="flex items-center justify-between mt-auto">
              <div class="flex items-center gap-4 text-sm text-slate-500">
                <div class="flex items-center gap-2">
                  <Calendar class="h-4 w-4" />
                  <span>{newsItems[0].date}</span>
                </div>
                <div class="flex items-center gap-2">
                  <User class="h-4 w-4" />
                  <span>{newsItems[0].author}</span>
                </div>
              </div>
              <a href={`/${lang}/news/${newsItems[0].id}`} class="btn btn-primary px-8 py-3 font-bold">Read More</a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- News Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-10">
      {newsItems.slice(1).map(news => (
        <NewsCard {...news} />
      ))}
    </div>

    <!-- Pagination -->
    <div class="mt-20 flex items-center justify-center gap-4">
      <button class="btn btn-secondary px-4 py-2 disabled:opacity-50" disabled>
        Previous
      </button>
      <div class="flex items-center gap-2">
        <button class="w-10 h-10 rounded-lg bg-brand-600 text-white font-bold text-sm shadow-md">1</button>
        <button class="w-10 h-10 rounded-lg bg-white border border-slate-200 text-slate-600 font-bold text-sm hover:border-brand-300 hover:text-brand-600 transition-all">2</button>
      </div>
      <button class="btn btn-secondary px-4 py-2 flex items-center gap-2">
        Next
        <ChevronRight class="h-4 w-4" />
      </button>
    </div>
  </Section>

  <!-- Newsletter Signup -->
  <Section background="slate" className="bg-brand-50 border-y border-brand-100">
    <div class="max-w-4xl mx-auto text-center py-12">
      <h2 class="text-3xl font-extrabold text-slate-900 mb-6">Stay Ahead of the Curve</h2>
      <p class="text-lg text-slate-600 mb-10 leading-relaxed">
        Subscribe to our weekly newsletter to receive exclusive insights, tech tips, and company updates directly in your inbox.
      </p>
      <form class="flex flex-col sm:flex-row gap-4 max-w-lg mx-auto">
        <input
          type="email"
          placeholder="Enter your email"
          class="flex-grow bg-white border border-slate-200 rounded-lg px-6 py-4 text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-all"
        />
        <button type="submit" class="btn btn-primary px-8 py-4 font-bold shadow-lg shadow-brand-500/20">Subscribe Now</button>
      </form>
      <p class="mt-6 text-xs text-slate-400">We respect your privacy. Unsubscribe at any time.</p>
    </div>
  </Section>
</BaseLayout>
