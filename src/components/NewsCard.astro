---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { Calendar, User, ArrowRight } from 'lucide-react';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface Props {
  id: string;
  title: string;
  excerpt: string;
  date: string;
  author: string;
  image: string;
  category: string;
}

const { id, title, excerpt, date, author, image, category } = Astro.props;
---

<article class="group bg-white border border-slate-100 rounded-2xl overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300">
  <div class="aspect-video relative overflow-hidden">
    <img
      src={image}
      alt={title}
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
    <span class="absolute top-4 left-4 bg-white/90 backdrop-blur-sm text-brand-600 text-xs font-bold uppercase tracking-widest px-3 py-1.5 rounded-full shadow-sm">
      {category}
    </span>
  </div>
  
  <div class="p-6 md:p-8">
    <div class="flex items-center gap-4 text-xs text-slate-500 mb-4">
      <div class="flex items-center gap-1.5">
        <Calendar class="h-3.5 w-3.5 text-brand-500" />
        <time datetime={date}>{date}</time>
      </div>
      <div class="flex items-center gap-1.5">
        <User class="h-3.5 w-3.5 text-brand-500" />
        <span>{author}</span>
      </div>
    </div>
    
    <h3 class="text-xl font-bold text-slate-900 mb-4 group-hover:text-brand-600 transition-colors line-clamp-2">
      <a href={`/${lang}/news/${id}`}>{title}</a>
    </h3>
    <p class="text-slate-600 text-sm mb-6 line-clamp-3 leading-relaxed">
      {excerpt}
    </p>
    
    <a
      href={`/${lang}/news/${id}`}
      class="inline-flex items-center gap-2 text-brand-600 font-bold text-sm group/link uppercase tracking-wider"
    >
      Read Full Article
      <ArrowRight class="h-4 w-4 transition-transform group-hover/link:translate-x-1.5" />
    </a>
  </div>
</article>
