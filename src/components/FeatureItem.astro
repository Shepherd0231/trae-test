---
import { type LucideIcon } from 'lucide-react';

interface Props {
  title: string;
  description: string;
  icon: LucideIcon;
  color?: string;
}

const { title, description, icon: Icon, color = 'text-brand-600 bg-brand-50' } = Astro.props;
---

<div class="group flex flex-col items-center text-center p-8 rounded-2xl bg-white border border-slate-100 hover:border-brand-200 hover:shadow-xl transition-all duration-300">
  <div class={`mb-6 p-4 rounded-xl transition-transform duration-500 group-hover:scale-110 group-hover:rotate-3 ${color}`}>
    <Icon class="h-8 w-8" />
  </div>
  <h3 class="text-xl font-bold text-slate-900 mb-4 group-hover:text-brand-600 transition-colors">
    {title}
  </h3>
  <p class="text-slate-600 text-sm leading-relaxed line-clamp-3">
    {description}
  </p>
</div>
