---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface Props {
  title?: string;
  subtitle?: string;
  ctaText?: string;
  ctaHref?: string;
  secondaryText?: string;
  secondaryHref?: string;
  image?: string;
}

const {
  title = t('home.hero.title'),
  subtitle = t('home.hero.subtitle'),
  ctaText = t('home.hero.cta'),
  ctaHref = `/${lang}/contact`,
  secondaryText = t('home.hero.secondary'),
  secondaryHref = `/${lang}/about`,
  image = 'https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&q=80&w=2070',
} = Astro.props;
---

<section class="relative min-h-[80vh] flex items-center bg-slate-900 overflow-hidden">
  <!-- Background Image with Overlay -->
  <div class="absolute inset-0 z-0">
    <img
      src={image}
      alt="Hero Background"
      class="w-full h-full object-cover opacity-40"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-slate-900 via-slate-900/80 to-transparent"></div>
  </div>

  <div class="container-custom relative z-10 py-20">
    <div class="max-w-3xl animate-in fade-in slide-in-from-left duration-700">
      <h1 class="text-4xl md:text-6xl font-extrabold text-white leading-tight mb-6">
        {title}
      </h1>
      <p class="text-xl md:text-2xl text-slate-300 mb-10 leading-relaxed max-w-2xl">
        {subtitle}
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a href={ctaHref} class="btn btn-primary px-8 py-3 text-lg">
          {ctaText}
        </a>
        <a href={secondaryHref} class="btn btn-secondary px-8 py-3 text-lg bg-white/10 text-white border-white/20 hover:bg-white/20">
          {secondaryText}
        </a>
      </div>
    </div>
  </div>
</section>
